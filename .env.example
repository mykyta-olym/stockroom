# Copy to .env for local development. These values are for a local database only.
DATABASE_URL=postgres://stockroom:stockroom@127.0.0.1:5433/stockroom

# The first admin account, created by `db:setup` when no admin exists yet.
ADMIN_EMAIL=admin@stockroom.test
ADMIN_PASSWORD=local-admin-password

# Set to false only when serving over plain HTTP, as the local demo does.
COOKIE_SECURE=false
